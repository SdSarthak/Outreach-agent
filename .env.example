# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o

# ElevenLabs Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here
# Required to place real outbound calls (the phone number linked to the agent)
ELEVENLABS_PHONE_NUMBER_ID=your_elevenlabs_phone_number_id_here

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Google API Configuration
GOOGLE_APPLICATION_CREDENTIALS=path/to/google-credentials.json
GMAIL_ADDRESS=your_gmail_address@gmail.com
# Where the cached OAuth token is written by `python main.py authorize-gmail`
GMAIL_TOKEN_PATH=token.json

# Database Configuration
DATABASE_URL=sqlite:///./outreach_agent.db

# Project Settings
# DRY_RUN=true simulates every call and email. Set it to false only once the
# credentials above are real: with false the agent dials customers for real.
DRY_RUN=true
LOG_LEVEL=INFO
ENABLE_CALL_LOGGING=true

# Call handling
CALL_POLL_INTERVAL=5
CALL_MAX_WAIT=120
RETRY_ATTEMPTS=3
RETRY_BACKOFF=1.5
HTTP_TIMEOUT=30
